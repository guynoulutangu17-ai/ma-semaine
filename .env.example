# « Ma semaine » : paramètres Firebase (Authentication Google).
# Copiez ce fichier en .env, remplissez les valeurs, puis lancez : node scripts/gen-firebase-config.mjs
# Cela écrit firebase-config.js. L'application n'a pas d'étape de build : ce fichier .env n'est pas lu par le navigateur.
#
# Où trouver ces valeurs : console Firebase > Paramètres du projet > Général > Vos applications > application Web > « Configuration SDK ».
# Ces valeurs sont publiques par conception. N'ajoutez JAMAIS de clé privée ni de compte de service.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=VOTRE-PROJET.firebaseapp.com
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
